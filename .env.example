NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://cinema:cinema@localhost:5432/cinema
LOG_LEVEL=info
PUBLIC_ERROR_BASE_URL=https://cinema.example/errors
# How long a seat hold survives before the next caller may take it (spec.md §9).
RESERVATION_TTL_SECONDS=600
# Postgres pool size. The contention suite raises this above its client count so
# it measures the seat race rather than the connection queue.
DATABASE_POOL_MAX=10
